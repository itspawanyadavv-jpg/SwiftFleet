# SwiftFleet Environment Configuration (Copy to .env if customizing)

# Store Hub Defaults (NCR / Ghaziabad default; can also sync deliveryRadiusKm from DRC API)
STORE_NAME=SwiftFleet Hub — Indirapuram
STORE_LAT=28.646705
STORE_LNG=77.444478
STORE_RADIUS_KM=3.0

# Optional DRC Store Integration (leave empty for 100% standalone mode)
DRC_STORE_API_URL=

# Store Mode: auto (uses Redis if reachable, else in-memory fallback) | redis | memory
FLEET_STORE_MODE=auto

# Redis Connection (Docker Compose uses redis://redis:6379; Upstash uses rediss://default:<token>@<host>:<port>)
REDIS_URL=redis://localhost:6379

# Concurrency & Delivery Rules
ORDER_LOCK_TTL_SECONDS=30
DELIVERY_GEOFENCE_METERS=150
OTP_MAX_ATTEMPTS=5

# CORS & Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3005,http://localhost:3000
VITE_API_BASE_URL=
VITE_WS_URL=

